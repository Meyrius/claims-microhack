# Optional package registries and forward proxy for corporate environments.
# Copy this file to .devcontainer/local.env before reopening the repository in a
# Dev Container. Uncomment only the settings your organization requires.
# The local file is ignored by Git. Never commit credentials to this example.
#
# These values are loaded by post-create.sh after the container image is built.
# Docker Desktop or the Dev Box host must provide any proxy or CA trust needed to
# download the base image and Dev Container features during the earlier build phase.

# NPM_CONFIG_REGISTRY=https://<npm-registry-host>/
# PIP_INDEX_URL=https://<python-package-index-host>/simple/
# UV_DEFAULT_INDEX=https://<python-package-index-host>/simple/

# Optional outbound HTTP proxy used inside the running container. Quote values that
# contain shell-special characters and URL-encode credentials when required.
# HTTP_PROXY='http://<proxy-host>:<port>'
# HTTPS_PROXY='http://<proxy-host>:<port>'
# NO_PROXY='localhost,127.0.0.1,.internal.example'

# Prefer the operating system trust store when your organization installs its CA in
# the container. Do not disable TLS certificate verification.
# UV_NATIVE_TLS=true
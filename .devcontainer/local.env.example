# Optional private package registries for corporate environments.
# Copy this file to .devcontainer/local.env and uncomment and replace values as needed.
# The local file is ignored by Git. Without it, the public npm and PyPI registries are used.

# NPM_CONFIG_REGISTRY=https://<npm-registry-host>/
# PIP_INDEX_URL=https://<python-package-index-host>/simple/
# UV_DEFAULT_INDEX=https://<python-package-index-host>/simple/
# Copy this file to .env at the repository root and replace the placeholders,
# or generate it with labautomation/setup_lab.py configure.

# Microsoft Foundry project and models
AI_FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project-name>
MODEL_DEPLOYMENT_NAME=gpt-5.4
FOUNDRY_MODEL=gpt-5.4
FOUNDRY_QUARANTINE_MODEL=gpt-5.4

# Mistral Document AI
MISTRAL_DOCUMENT_AI_ENDPOINT=https://<foundry-resource>.services.ai.azure.com
# Leave empty to use DefaultAzureCredential when Foundry local authentication is disabled.
MISTRAL_DOCUMENT_AI_KEY=
MISTRAL_DOCUMENT_AI_DEPLOYMENT_NAME=mistral-document-ai-2512
MISTRAL_DOCUMENT_AI_API_VERSION=2024-05-01-preview

# Azure AI Search and Foundry IQ
FOUNDRY_IQ_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
FOUNDRY_IQ_SEARCH_KEY=<search-admin-key>
FOUNDRY_IQ_SEARCH_INDEX_NAME=crash-statements
FOUNDRY_IQ_SEARCH_API_VERSION=2023-11-01
FOUNDRY_IQ_SEMANTIC_CONFIG_NAME=crash-statements-semantic-config
FOUNDRY_IQ_KNOWLEDGE_SOURCE_NAME=crash-statements-ks
FOUNDRY_IQ_KNOWLEDGE_BASE_NAME=crash-statements-kb
FOUNDRY_IQ_POLICIES_KNOWLEDGE_SOURCE_NAME=policies-blob-ks
FOUNDRY_IQ_POLICIES_KNOWLEDGE_BASE_NAME=policies-kb
FOUNDRY_IQ_MCP_API_VERSION=2026-04-01
FOUNDRY_IQ_SEARCH_CONNECTION_NAME=claims-search
FOUNDRY_IQ_CRASH_STATEMENTS_CONNECTION_NAME=claims-crash-statements-kb
FOUNDRY_IQ_POLICIES_CONNECTION_NAME=claims-policies-kb
SEARCH_SERVICE_ENDPOINT=https://<search-service>.search.windows.net
SEARCH_ADMIN_KEY=<search-admin-key>

# Azure Storage policy documents
# Use a ResourceId connection for the Search managed identity, or a full connection string.
AZURE_STORAGE_CONNECTION_STRING=ResourceId=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.Storage/storageAccounts/<storage-account>/;
AZURE_STORAGE_ACCOUNT_NAME=<storage-account>
AZURE_STORAGE_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.Storage/storageAccounts/<storage-account>
AZURE_POLICIES_CONTAINER_NAME=policies

# Sequential workflow
HUMAN_REVIEW_CONFIDENCE_THRESHOLD=0.9
